                Writedata[0] |= 0x04; // B+
                Writedata[0] &= unchecked((byte)~0x08); // B-
                CIFX.xChannelWrite(Writedata);
                button6.Text = "수동운전 상태";
            }
        }

        private void radioButton3_CheckedChanged(object sender, EventArgs e)//b실린더 후진
