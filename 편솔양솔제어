        private void Form1_Load(object sender, EventArgs e)
        {
            uint connect = CIFX.DriveConnect();
            button6.Text = "수동운전";
            if (connect != 0)
            {
                button1.Text = "Communication OK";
                button1.ForeColor = Color.Blue;
                button1.BackColor = Color.Pink;

                timer1.Interval = 50;
                timer1.Start();

                button4_Click(null, null); // 초기화
            }
            else
            {
                button4.Text = "Communication NG";

            }
        }

        private void timer1_Tick(object sender, EventArgs e)
        {
            if (button1.Text == "Communication OK")
            {
                Readdata = CIFX.xChannelRead();
                ReadDataConv = Convert.ToString(Readdata[18], 2).PadLeft(8, '0');
                label6.Text = ReadDataConv;
                WritedataConv = Convert.ToString(Writedata[0], 2).PadLeft(8, '0');
                label7.Text = WritedataConv;







                label8.BackColor = (ReadDataConv[7] == '1') ? Color.GreenYellow : Color.White;
                label9.BackColor = (ReadDataConv[6] == '1') ? Color.GreenYellow : Color.White;




                label11.BackColor = (ReadDataConv[5] == '1') ? Color.GreenYellow : Color.White;
                label10.BackColor = (ReadDataConv[4] == '1') ? Color.GreenYellow : Color.White;





                label13.BackColor = (ReadDataConv[3] == '1') ? Color.GreenYellow : Color.White;
                label12.BackColor = (ReadDataConv[2] == '1') ? Color.GreenYellow : Color.White;
            }


        }

        private void radioButton1_CheckedChanged(object sender, EventArgs e)//a실린더 전진
        {
            if (ReadDataConv[7] == '1')
            {
                Writedata[0] |= 0x01;
                Writedata[0] &= unchecked((byte)~0x02);
                CIFX.xChannelWrite(Writedata);
                button6.Text = "수동운전 상태";
            }
        }

        private void radioButton2_CheckedChanged(object sender, EventArgs e)//a실린더 후진

        {
            if (ReadDataConv[6] == '1')
            {
                Writedata[0] |= 0x02; // A-
                Writedata[0] &= unchecked((byte)~0x01); // A+
                CIFX.xChannelWrite(Writedata);
                button6.Text = "수동운전 상태";
            }

        }

        private void radioButton4_CheckedChanged(object sender, EventArgs e)//b실린더 전진
        {
            if(ReadDataConv[5] == '1')
