        }

        private void button4_Click(object sender, EventArgs e)
        {
         
            Writedata[0] &= unchecked((byte)~0x01); // A+
            Writedata[0] &= unchecked((byte)~0x04); // B+
            Writedata[0] &= unchecked((byte)~0x10); // C+

            // 후진 신호 ON
            Writedata[0] |= 0x02; // A-
            Writedata[0] |= 0x08; // B-
            Writedata[0] |= 0x20; // C-

            CIFX.xChannelWrite(Writedata);
            button4.BackColor = Color.LightGray;
        }

        private void radioButton5_CheckedChanged(object sender, EventArgs e)//c 실린더 후진
        {
            if (ReadDataConv[2] == '1')
            {
                Writedata[0] &= unchecked((byte)~0x10);
                CIFX.xChannelWrite(Writedata);
                button6.Text = "수동운전 상태";
            }
        }

        private void button2_Click(object sender, EventArgs e)//자동운전
        {
            timer2.Interval = 300;
            timer2.Start();
            timer3.Interval = 300;
            timer3.Start();
            button6.Text = "자동 운전 상태";
            A = 1;
            Auto = 0;
            Count = -1;
        }

        private void timer2_Tick(object sender, EventArgs e)//자동운전관련
        {
            label15.Text = Count.ToString();
            int Counting = Convert.ToInt32(numericUpDown1.Value);
            if (A == 1 || (A == 2 && Count < Counting))
            {
                switch (Auto)
                {
                    case 0:
                        if (ReadDataConv[6] == '1' && ReadDataConv[5] == '1'
                        && ReadDataConv[3] == '1') // A+ 조건 확인

                        {
                            Writedata[0] = 0x15;
                            CIFX.xChannelWrite(Writedata);
                            Auto++;
                        }
                        break;
                    case 1:
                        if (ReadDataConv[6] == '1' && ReadDataConv[4] == '1'
                        && ReadDataConv[2] == '1') // A- 조건 확인

                        {
                            Writedata[0] = 0x1a;
                            CIFX.xChannelWrite(Writedata);
                            Auto++;
                        }
                        break;
                    case 2:
                        if (ReadDataConv[7] == '1' && ReadDataConv[5] ==

                        '1') // A+와 B+ 조건 확인

                        {
                            Writedata[0] = 0x09;
                            CIFX.xChannelWrite(Writedata);
                            Auto++;
                        }
                        break;
                    case 3:
                        if (ReadDataConv[6] == '1' && ReadDataConv[5] == '1'
                        && ReadDataConv[3] == '1') // B- 조건 확인

                        {
                            Writedata[0] = 0x15;
                            CIFX.xChannelWrite(Writedata);
                            Auto++;
                        }
                        break;
                    case 4:
                        if (ReadDataConv[4] == '1' && ReadDataConv[2] ==

                        '1') // B+와 C+ 조건 확인

                        {
                            Writedata[0] = 0x1a;
                            CIFX.xChannelWrite(Writedata);
                            Auto++;
                        }
                        break;
                    case 5:
                        if (ReadDataConv[7] == '1' && ReadDataConv[5] == '1')
                        {
                            Writedata[0] = 0x09;
                            CIFX.xChannelWrite(Writedata);
                            Auto++;
                        }
                        break;
                    case 6:
                        if (ReadDataConv[6] == '1') // C+ 조건 확인
                        {
                            Auto = 0;
                            if (A == 2) Count++;
                        }
                        break;
                }
            }
        }

